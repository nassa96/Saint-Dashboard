# ============================================================
#  SAINT / OMNIVEX — ENVIRONMENT CONFIG
#  Copy this file to ".env" and fill in values.
#  NEVER commit your real .env (it is gitignored).
# ============================================================

# ---- Server ----
PORT=3000

# ---- Dashboard authentication ----
# Auth is ENABLED automatically when DASHBOARD_PASSWORD is set. Leave blank for
# local/dev (open). ALWAYS set a password before exposing to a network.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Secret used to sign session tokens. If blank, a random one is generated at
# boot (sessions won't survive a restart). Set a long random value in prod.
SESSION_SECRET=

# ---- Alerts (Telegram / Discord) — optional ----
# Telegram: create a bot via @BotFather, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: a channel webhook URL.
DISCORD_WEBHOOK_URL=
# Fire an alert when a memecoin candidate scores >= this (0-100).
ALERT_MEMECOIN_MIN_SCORE=70
# Send an alert on every executed fill (paper or live).
ALERT_ON_FILLS=true

# ---- Trading mode ----
# PAPER = simulated fills at real prices (safe, default)
# LIVE  = route real orders to the exchange (requires LIVE_TRADING_ENABLED=true)
TRADING_MODE=PAPER

# Master kill-switch. Live orders are IMPOSSIBLE unless this is exactly "true".
# Keep this false until you have validated the strategy in PAPER mode.
LIVE_TRADING_ENABLED=false

# Extra confirmation phrase required to arm live trading (defense in depth).
# Must equal "I ACCEPT THE RISK" for live orders to be allowed.
LIVE_TRADING_CONFIRM=

# Use exchange testnet/sandbox endpoints instead of production when available.
USE_TESTNET=true

# ---- Capital / risk (paper defaults) ----
STARTING_EQUITY=10000
MAX_POSITION_PCT=0.20        # max % of equity in a single asset
MAX_PORTFOLIO_RISK_PCT=0.60  # max % of equity deployed at once
MAX_DAILY_DRAWDOWN_PCT=0.10  # halt trading if daily loss exceeds this
PER_TRADE_RISK_PCT=0.02      # risk budget per trade
MIN_SIGNAL_CONFIDENCE=0.55   # ignore signals weaker than this
MIN_TRADE_USD=10             # fee-aware floor: never trade smaller than this (protects small accounts)

# ---- Universe (comma separated, exchange-neutral symbols) ----
TRADE_UNIVERSE=BTC-USD,ETH-USD,SOL-USD,AVAX-USD,LINK-USD,DOGE-USD

# ---- Strategy ----
# Global default strategy: momentum | meanreversion | ensemble
STRATEGY=momentum
# strategies blended when STRATEGY=ensemble
ENSEMBLE_MEMBERS=momentum,meanreversion

# ---- Per-symbol / per-strategy routing (optional) ----
# Explicit routes win over everything: "BTC-USD:momentum,SOL-USD:meanreversion"
SYMBOL_STRATEGIES=
# Which symbols count as "majors" (everything else is treated as an alt)
MAJORS=BTC-USD,ETH-USD
# Strategy applied to majors / alts when no explicit route matches (blank = use STRATEGY)
STRATEGY_MAJORS=
STRATEGY_ALTS=

# ---- Exchange API keys (READ-ONLY keys recommended until live) ----
# Binance.US
BINANCEUS_API_KEY=
BINANCEUS_API_SECRET=

# Coinbase Exchange (api.exchange.coinbase.com) — HMAC key/secret/passphrase
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=

# Kraken
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Preferred execution venue: binanceus | coinbase | kraken
PRIMARY_EXCHANGE=coinbase

# ---- Memecoin scanner (DexScreener public API, no key needed) ----
MEMECOIN_CHAINS=solana,base,ethereum
MEMECOIN_MIN_LIQUIDITY_USD=15000
MEMECOIN_MIN_VOLUME_USD=50000

# ============================================================
#  ON-CHAIN WALLET SWAPS (self-custody)  —  DANGER ZONE
#  These keys can MOVE YOUR FUNDS. Leave blank for quote-only.
#  Live swaps ALSO require the three live-trading locks above
#  PLUS ONCHAIN_TRADING_ENABLED=true.
# ============================================================
ONCHAIN_TRADING_ENABLED=false
MAX_SWAP_USD=25            # hard per-swap spend cap (safety)
SWAP_SLIPPAGE_BPS=100      # 100 = 1.0% max slippage

# Solana (swaps via Jupiter aggregator)
SOLANA_PRIVATE_KEY=        # base58 secret key (NEVER commit)
SOLANA_RPC=https://api.mainnet-beta.solana.com

# EVM (swaps via 0x; supports ethereum/base/bsc)
EVM_PRIVATE_KEY=           # 0x-prefixed hex private key (NEVER commit)
EVM_CHAIN=base             # ethereum | base | bsc
EVM_RPC=                   # optional custom RPC; sensible default used if blank
ZEROX_API_KEY=            # optional 0x API key for EVM quotes
