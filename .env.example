# ============================================================
#  SAINT / OMNIVEX — ENVIRONMENT CONFIG
#  Copy this file to ".env" and fill in values.
#  NEVER commit your real .env (it is gitignored).
# ============================================================

# ---- Server ----
PORT=3000

# ---- Dashboard authentication ----
# Auth is ENABLED automatically when DASHBOARD_PASSWORD is set. Leave blank for
# local/dev (open). ALWAYS set a password before exposing to a network.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Secret used to sign session tokens. If blank, a random one is generated at
# boot (sessions won't survive a restart). Set a long random value in prod.
SESSION_SECRET=

# ---- Alerts (Telegram / Discord) — optional ----
# Telegram: create a bot via @BotFather, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: a channel webhook URL.
DISCORD_WEBHOOK_URL=
# Fire an alert when a memecoin candidate scores >= this (0-100).
ALERT_MEMECOIN_MIN_SCORE=70
# Send an alert on every executed fill (paper or live).
ALERT_ON_FILLS=true

# ---- Trading mode ----
# PAPER = simulated fills at real prices (safe, default)
# LIVE  = route real orders to the exchange (requires LIVE_TRADING_ENABLED=true)
TRADING_MODE=PAPER

# Master kill-switch. Live orders are IMPOSSIBLE unless this is exactly "true".
# Keep this false until you have validated the strategy in PAPER mode.
LIVE_TRADING_ENABLED=false

# Extra confirmation phrase required to arm live trading (defense in depth).
# Must equal "I ACCEPT THE RISK" for live orders to be allowed.
LIVE_TRADING_CONFIRM=

# Use exchange testnet/sandbox endpoints instead of production when available.
USE_TESTNET=true

# ---- Capital / risk (paper defaults) ----
STARTING_EQUITY=10000
MAX_POSITION_PCT=0.20        # max % of equity in a single asset
MAX_PORTFOLIO_RISK_PCT=0.60  # max % of equity deployed at once
MAX_DAILY_DRAWDOWN_PCT=0.10  # Aegis HARD killswitch: halt + flatten all positions if daily loss hits this
# Aegis Guardian SOFT brake (two-tier drawdown): well before the hard
# killswitch above, halve new-entry size and cap leverage to 1x. Not
# sticky — re-evaluated live every tick, clears the instant drawdown
# recovers back under this threshold. Default 5% (half the 10% hard limit).
SOFT_BRAKE_DRAWDOWN_PCT=0.05
PER_TRADE_RISK_PCT=0.02      # risk budget per trade
MIN_SIGNAL_CONFIDENCE=0.55   # ignore signals weaker than this
MIN_TRADE_USD=10             # fee-aware floor: never trade smaller than this (protects small accounts)
# Micro-capital cold-start mode: an ABSOLUTE dollar ceiling per trade,
# independent of (and in addition to) the percentage-based caps above.
# 0 = disabled (percentage caps only, the historical default behavior).
# Set this to something like 5 while a strategy is still unproven.
MAX_TRADE_USD=0
# Once MAX_DAILY_DRAWDOWN_PCT is breached, stay halted for this many hours
# on a rolling clock (haltUntil = triggerTime + this many hours) rather
# than clearing at the next calendar-day boundary.
HALT_COOLDOWN_HOURS=24
# Survivability: pause NEW entries (exits still run) if this fraction or
# more of the tracked universe is simultaneously reading EXTREME volatility
# at once. Auto-clears the same day once it passes (precautionary, not tied
# to an actual loss like the daily-drawdown breaker above).
MAX_EXTREME_FRACTION_FOR_HALT=0.5
# Macro risk-appetite overlay (Fear & Greed Index + global market-cap trend)
# — can only ever shrink deployed capital in a risk-off backdrop, never
# push it above MAX_PORTFOLIO_RISK_PCT above. Set false to disable.
MACRO_OVERLAY_ENABLED=true

# ---- AWP Capital Ring: Shield/Spear two-pool allocation (optional) ----
# Disabled by default — the engine behaves exactly as before (single
# unified allocator) unless this is enabled. Shield = conservative/low-vol
# strategies; Spear = high-conviction momentum strategies with their own
# scoped daily-loss ceiling (halts NEW spear entries only, never the whole
# engine, on breach).
CAPITAL_RING_ENABLED=false
CAPITAL_RING_SHIELD_PCT=0.8
CAPITAL_RING_SPEAR_PCT=0.2
CAPITAL_RING_SPEAR_STRATEGIES=fibonacci
CAPITAL_RING_SPEAR_DAILY_LOSS_CEILING_PCT=0.05
CAPITAL_RING_SPEAR_HALT_COOLDOWN_HOURS=24

# ---- Universe (comma separated, exchange-neutral symbols) ----
TRADE_UNIVERSE=BTC-USD,ETH-USD,SOL-USD,AVAX-USD,LINK-USD,DOGE-USD

# ---- Strategy ----
# Global default strategy: momentum | meanreversion | marketmaking | ensemble
# (overlord / autonomouswealth exist as selectable placeholder slots that
#  always return FLAT until you fill in docs/strategies/*.md. "dnfh" is also
#  selectable here but stays FLAT too — the real DNFH is implemented
#  separately as a cross-venue module, see src/yield/dnfh.js + /api/dnfh/*)
STRATEGY=momentum
# strategies blended when STRATEGY=ensemble
ENSEMBLE_MEMBERS=momentum,meanreversion

# Capital allocation weighting: score (default, conviction-weighted) |
# sortino (blends conviction with trailing risk-adjusted downside return)
ALLOCATION_METHOD=score

# ---- Per-symbol / per-strategy routing (optional) ----
# Explicit routes win over everything: "BTC-USD:momentum,SOL-USD:meanreversion"
SYMBOL_STRATEGIES=
# Which symbols count as "majors" (everything else is treated as an alt)
MAJORS=BTC-USD,ETH-USD
# Strategy applied to majors / alts when no explicit route matches (blank = use STRATEGY)
STRATEGY_MAJORS=
STRATEGY_ALTS=

# ---- Exchange API keys (READ-ONLY keys recommended until live) ----
# Binance.US
BINANCEUS_API_KEY=
BINANCEUS_API_SECRET=

# Coinbase Exchange (api.exchange.coinbase.com) — HMAC key/secret/passphrase
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=

# Kraken
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Preferred execution venue: binanceus | coinbase | kraken
PRIMARY_EXCHANGE=coinbase

# ---- Memecoin scanner (DexScreener public API, no key needed) ----
MEMECOIN_CHAINS=solana,base,ethereum
MEMECOIN_MIN_LIQUIDITY_USD=15000
MEMECOIN_MIN_VOLUME_USD=50000

# ============================================================
#  ON-CHAIN WALLET SWAPS (self-custody)  —  DANGER ZONE
#  These keys can MOVE YOUR FUNDS. Leave blank for quote-only.
#  Live swaps ALSO require the three live-trading locks above
#  PLUS ONCHAIN_TRADING_ENABLED=true.
# ============================================================
ONCHAIN_TRADING_ENABLED=false
MAX_SWAP_USD=25            # hard per-swap spend cap (safety)
SWAP_SLIPPAGE_BPS=100      # 100 = 1.0% max slippage

# MEV defense (protects YOUR swaps from being sandwiched — never touches
# anyone else's transactions). All optional, safe no-op defaults.
MEV_SPLIT_THRESHOLD_USD=250   # swaps above this + risky get tranched
MEV_MAX_CHUNKS=4
MEV_MIN_CHUNK_USD=25          # never split into fee-eating dust
MEV_CHUNK_DELAY_MS=4000
MEV_ALWAYS_PROTECT=false      # force protected relay even on low-risk swaps
EVM_PROTECT_RPC=              # e.g. https://rpc.flashbots.net (Ethereum mainnet)

# Solana (swaps via Jupiter aggregator)
SOLANA_PRIVATE_KEY=        # base58 secret key (NEVER commit)
SOLANA_RPC=https://api.mainnet-beta.solana.com

# EVM (swaps via 0x; supports ethereum/base/bsc)
EVM_PRIVATE_KEY=           # 0x-prefixed hex private key (NEVER commit)
EVM_CHAIN=base             # ethereum | base | bsc
EVM_RPC=                   # optional custom RPC; sensible default used if blank
ZEROX_API_KEY=            # optional 0x API key for EVM quotes

# Tron — balance reads work out of the box (public TronGrid API, no key
# needed if you set TRON_ADDRESS). Swaps are intentionally disabled until
# you configure a vetted aggregator — see docs/TRON_SWAP.md.
TRON_ADDRESS=              # public address, for read-only monitoring w/ NO key
TRON_PRIVATE_KEY=          # only needed if you want this server to sign Tron txs later
TRONGRID_API_KEY=          # optional, raises TronGrid's public rate limit
SUNSWAP_API_KEY=           # not yet wired up — see docs/TRON_SWAP.md

# ============================================================
#  HYPERLIQUID (perps DEX) — MONITOR-ONLY by default
#  Reads need ONLY a public wallet address, no key of any kind.
#  The optional API private key is for a dedicated, trade-only
#  "API wallet" (generate one in Hyperliquid's UI) — NEVER your
#  main wallet's key. Leveraged orders are a separate, manually
#  invoked action (POST /api/hyperliquid/order); the automatic
#  rotation engine never trades here on its own.
# ============================================================
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_API_PRIVATE_KEY=
# Hard cap on leverage for the DNFH (delta-neutral funding harvest) module
# below — this is a yield-harvest tool, not a directional leverage play.
HYPERLIQUID_MAX_LEVERAGE=2

# DNFH (delta-neutral funding harvest) refinements — all optional, these are the defaults.
# DNFH_ENTRY_THRESHOLD_ANNUAL_PCT=22
# DNFH_MIN_NET_EDGE_7D_PCT=0.75
# DNFH_OPEN_FEE_PCT=0.02
# DNFH_CLOSE_FEE_PCT=0.02
# DNFH_BASIS_SLIPPAGE_PCT=0.05
# DNFH_BORROW_COST_ANNUAL_PCT=0
# DNFH_REBALANCE_DELTA_DRIFT_PCT=1.5
# DNFH_REBALANCE_NEGATIVE_EPOCHS=3

# ============================================================
#  DNFH (Delta-Neutral Funding Harvest) — long spot (Base) + short perp
#  (HyperLiquid) to collect positive funding, net price exposure ~0.
#  Real strategy, no extra env vars of its own — reuses the EVM wallet
#  keys above for the spot leg and the HyperLiquid keys above for the
#  perp leg. It will NEVER guess a token's contract address for you
#  (you must verify and pass it yourself); it NEVER auto-trades; both
#  legs require the full live-arm gate. See POST /api/dnfh/plan,
#  GET /api/dnfh/scan, POST /api/dnfh/execute.
# ============================================================
