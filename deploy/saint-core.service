# systemd unit for running SAINT CORE directly on a VPS (no Docker).
# Install:
#   sudo cp deploy/saint-core.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now saint-core
# Edit User/paths below to match your server.

[Unit]
Description=SAINT CORE — Omnivex Trading Intelligence
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=saint
WorkingDirectory=/opt/saint-dashboard
EnvironmentFile=/opt/saint-dashboard/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
