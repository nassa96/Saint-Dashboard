# ============================================================
# AGGRESSIVE PAPER test profile — high-risk, hypothetical sizing only.
# Not approved for live use. Higher exposure means larger simulated drawdowns;
# paper results never authorize live trading.
# ============================================================

# ---- Capital & risk ----
STARTING_EQUITY=1000            # hypothetical PAPER book equity
MAX_POSITION_PCT=0.30           # max 30% of equity in any one coin
MAX_PORTFOLIO_RISK_PCT=0.80     # max 80% deployed; only 20% cash buffer
MAX_DAILY_DRAWDOWN_PCT=0.15     # AUTO-HALT the day you're down 15%
PER_TRADE_RISK_PCT=0.03         # risk ~3% of equity per trade
MIN_SIGNAL_CONFIDENCE=0.50

# ---- Strategy ----
STRATEGY=momentum
ENSEMBLE_MEMBERS=momentum,meanreversion

# ---- SAFETY: live trading OFF. ----
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
USE_TESTNET=true
