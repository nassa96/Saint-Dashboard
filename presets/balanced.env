# ============================================================
# BALANCED preset  —  the built-in defaults
# Reasonable middle ground once conservative has proven itself live.
# ============================================================

# ---- Capital & risk ----
STARTING_EQUITY=1000            # set to YOUR real deposit
MAX_POSITION_PCT=0.20           # max 20% of equity in any one coin
MAX_PORTFOLIO_RISK_PCT=0.60     # max 60% deployed; 40%+ stays in cash
MAX_DAILY_DRAWDOWN_PCT=0.10     # AUTO-HALT the day you're down 10%
PER_TRADE_RISK_PCT=0.02         # risk ~2% of equity per trade
MIN_SIGNAL_CONFIDENCE=0.55

# ---- Strategy ----
STRATEGY=momentum
ENSEMBLE_MEMBERS=momentum,meanreversion

# ---- SAFETY: live trading OFF. ----
MODE=PAPER
LIVE_TRADING_ENABLED=false
USE_TESTNET=true
