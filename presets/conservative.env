# ============================================================
# CONSERVATIVE PAPER profile — a hypothetical test baseline, not live approval.
# Account reconciliation, final-fill recovery, and venue-native protection are
# not implemented. Copy selected values into .env only for a PAPER test.
# ============================================================

# ---- Capital & risk ----
STARTING_EQUITY=1000            # hypothetical PAPER book equity
MAX_POSITION_PCT=0.10           # max 10% of equity in any one coin
MAX_PORTFOLIO_RISK_PCT=0.40     # max 40% deployed; 60%+ stays in cash
MAX_DAILY_DRAWDOWN_PCT=0.05     # AUTO-HALT the day you're down 5%
PER_TRADE_RISK_PCT=0.01         # max notional per entry ~= 1% of equity (not loss-at-risk)
MIN_SIGNAL_CONFIDENCE=0.65      # ignore weak/uncertain signals

# ---- Strategy (use whatever passed `npm run validate`) ----
STRATEGY=momentum
ENSEMBLE_MEMBERS=momentum,meanreversion

# ---- SAFETY: live trading OFF. Paper mode, real prices. ----
MODE=PAPER
LIVE_TRADING_ENABLED=false
USE_TESTNET=true
# LIVE_TRADING_CONFIRM stays blank until you deliberately go live.
