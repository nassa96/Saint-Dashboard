# ============================================================
# $20 USDC preset  —  optimized for a tiny, fee-constrained account
#
# The whole game at $20 is: DON'T let fees eat you. That means
# trade RARELY, only on strong signals, and CONCENTRATE into one
# position at a time instead of diversifying $20 six ways.
#
#   Usage:  cp presets/twenty-usdc.env .env   (then fill exchange keys)
# ============================================================

# ---- Capital ----
STARTING_EQUITY=20              # your $20 USDC (USDC = USD 1:1, free to convert on Coinbase)
MIN_TRADE_USD=5                 # never place a trade smaller than $5 (above exchange mins, below fee-death)

# ---- Concentrate, don't diversify (you can't diversify $20) ----
MAX_POSITION_PCT=1.0            # allow the full $20 in the single best coin
MAX_PORTFOLIO_RISK_PCT=1.0      # fully deployable (no point holding idle cash at $20)
PER_TRADE_RISK_PCT=0.05

# ---- Trade rarely, only high conviction (each trade costs ~0.6-1.2%) ----
MIN_SIGNAL_CONFIDENCE=0.72      # skip everything but the strongest signals
MAX_DAILY_DRAWDOWN_PCT=0.10     # auto-halt if you're down 10% ($2) on the day

# ---- Universe: 3 most-liquid, lowest-slippage coins only ----
TRADE_UNIVERSE=BTC-USD,ETH-USD,SOL-USD

# ---- Strategy: momentum (the one that passed walk-forward) ----
STRATEGY=momentum

# ---- Venue: your money is on Coinbase. USE ADVANCED TRADE (0.60% taker),
#      NOT the one-tap app (flat $0.99 = ~50% fee on a $2 order!).
#      When you scale up, Binance.US (0.10%) is far cheaper. ----
PRIMARY_EXCHANGE=coinbase
# Fill these on the Connections page (/connect.html) or here:
# COINBASE_API_KEY_NAME=
# COINBASE_API_KEY_SECRET=
# COINBASE_PORTFOLIO_UUID=

# ---- SAFETY: live trading OFF. Prove it in paper first. ----
MODE=PAPER
LIVE_TRADING_ENABLED=false
USE_TESTNET=true
# Set LIVE_TRADING_CONFIRM="I ACCEPT THE RISK" only when you deliberately go live.
